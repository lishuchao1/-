# Copy to .env and fill in your own values. .env is git-ignored.
# Provider must be OpenAI-compatible (chat completions + tool calls).

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL_MAIN=deepseek-v4-pro
LLM_MODEL_SUB=deepseek-flash

# Optional per-role overrides; empty means LLM_MODEL_SUB.
LLM_MODEL_ROLE_REVIEWER=
LLM_MODEL_ROLE_WRITER=
LLM_MODEL_ROLE_MARKETING=

LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
# Artificial delay before each call, milliseconds. 0 = off.
LLM_DELAY_MS=0

# Unit prices in CNY per million tokens (peak-hour, cache-miss tier).
PRICE_MAIN_IN_PER_MTOK=9.0
PRICE_MAIN_OUT_PER_MTOK=27.0
PRICE_SUB_IN_PER_MTOK=2.0
PRICE_SUB_OUT_PER_MTOK=8.0

# Thinking mode. When enabled, the provider's reasoning field is echoed back
# on every follow-up turn.
THINKING_MAIN=0
THINKING_SUB=0

RUN_DEFAULT_BUDGET_TOKENS=200000
RUN_DEFAULT_MAX_DEPTH=2
RUN_DEFAULT_MAX_CONCURRENCY=3

# A new sub-agent is only spawned if at least this many tokens are unreserved.
RUN_BUDGET_RESERVE_TOKENS=3000
# Hard cap on the supervisor-provided context, characters.
CONTEXT_MAX_CHARS=2000
# Backoff base for retryable errors (429/5xx/timeout), seconds.
LLM_RETRY_BACKOFF_S=2

# Demo fault injection: off | transient | permanent | structural | task.
FAILURE_INJECT_MODE=off

BREAKER_FAIL_THRESHOLD=3
BREAKER_COOLDOWN_S=30
# Whole-run watchdog: cancel after this many seconds without a successful step.
RUN_STALL_TIMEOUT_S=180

# Optional fallback provider, used on quota/auth/connect/retryable failures.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_MAIN=
LLM_FALLBACK_MODEL_SUB=

# Directory for run checkpoints (git-ignored).
RUN_STATE_DIR=runs